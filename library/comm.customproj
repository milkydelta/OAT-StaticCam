<Project>
    <!-- Yes. I wrote an MSBuild file for running GCC-->
    <!-- No. It's not needed. The .sh file worked fine-->
  <PropertyGroup>
    <OutputName>comm.so</OutputName>
    <OutputPath>bin/</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <Toolchain>x86_64-pc-linux-gnu</Toolchain>
    <CC>$(Toolchain)-gcc</CC>
  </PropertyGroup>

  <ItemGroup>
    <GccCompile Include="lincomm.c" />
  </ItemGroup>

  <Target Name="Build" Inputs="@(GccCompile)" Outputs="$(OutputPath)$(OutputName)" Condition="$([System.OperatingSystem]::IsLinux())" >
    <MakeDir Directories="$(OutputPath)" Condition="!Exists('$(OutputPath)')" />
    <Message Text="$(CC) -shared -o $(OutputPath)$(OutputName) @(GccCompile, ' ')" Importance="high"/>
    <Exec Command="$(CC) -shared -o $(OutputPath)$(OutputName) @(GccCompile, ' ')" ConsoleToMsBuild="true"/>
  </Target>

  <Target Name="GetCopyToPublishDirectoryItems"></Target>
</Project>
